# Copia este archivo a dashboard/.env y completa el valor real.
# NUNCA subas el .env con credenciales al repo (está en .gitignore).
#
# Cadena de conexión a PostgreSQL en formato libpq (clave=valor).
# En GitHub Actions este valor va como Secret (SCR_DATABASE_URL), no en el repo.
SCR_DATABASE_URL=host=TU_HOST.rds.amazonaws.com port=5432 dbname=postgres user=TU_USUARIO password=TU_PASSWORD

# Nivel de logging del ETL (opcional): DEBUG | INFO | WARNING | ERROR
ETL_LOG_LEVEL=INFO
